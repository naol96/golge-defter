# Örnek anahtar isimleri, gerçek gizli bilgi GİRMEYİN.
# Bu dosyayı kopyalayın: cp .env.example .env  ( .env git'e girmez )
APP_MODE=PAPER
KILL_SWITCH=true

# LLM analist (--analyst llm) — OpenRouter örneği:
